[Unit]
Description=Quiet fan controller (ttyS1 Vnn duty)
After=scemd.service syno-fan-modules-load.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/fanctl.py
Restart=always
RestartSec=5
# DSM's systemd copies stdout to a log file on the system RAID, which wakes
# the disks; fanctl already logs to /run. stderr kept for crash tracebacks.
StandardOutput=null

[Install]
WantedBy=multi-user.target
